# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lockfiles from other package managers (this project uses pnpm)
package-lock.json
yarn.lock

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local env files
.env*.local
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.blackboxcli/

# editors / IDE
.idea/
*.swp
*.swo
*~

# OS junk files
Thumbs.db
ehthumbs.db
Desktop.ini

# logs
*.log

# build/tooling caches
.turbo/
.eslintcache
*.tmp
*.temp

# Ignorar los fragmentos de caché interna de Graphify
graphify-out/cache/
graphify-out/.*.json
graphify-out/.*
graphify-out/cost.json

# Permitir explícitamente subir solo los archivos del árbol final
# (se conservan para reutilizar el mapeo del proyecto en otros equipos)
!graphify-out/GRAPH_REPORT.md
!graphify-out/graph.json
!graphify-out/graph.html