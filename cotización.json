    "allowance_charges": [ // en este objeto los cargos o descuentos globales a la cotización.
        {
            "scope": "global",
            "value_type": "percentage",
            "reason": "Timbre",
            "reason_code": "01",
            "charge_indicator": true, // charge_indicator: true significa que es un cargo, que se le suma a la factura y false es que se descuenta. 
